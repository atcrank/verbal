# =============================================================================
# Verbal Project — Secrets Template
# =============================================================================
# Copy this file to .env.secrets and fill in real values.
# .env.secrets is gitignored and will NOT be committed.

# HuggingFace access token (required for gated model downloads)
HF_TOKEN=

# SSL / TLS — set these on the production server
# Granian will terminate TLS natively when both paths are provided.
# SSL_CERT_PATH=/etc/ssl/certs/verbal.pem
# SSL_KEY_PATH=/etc/ssl/private/verbal.key
