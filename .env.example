# =============================================================================
# Verbal Project — Environment Configuration
# =============================================================================
# Copy this file to .env and edit values for your deployment.
# .env is already in .gitignore and will NOT be committed.
#
# Master environment switch: "dev" or "prod"
VERBAL_ENV=dev
PYENV_ACTIVATE="../../py313/bin/activate"

# Django core
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=verbal_db
DB_USER=verbal_user
DB_PASSWORD=verbal_password
DB_HOST=localhost
DB_PORT=5433

# Microservice role: standalone | inference | web | worker
VERBAL_ROLE=standalone

# Inference server URL (used when VERBAL_ROLE=web or worker)
INFERENCE_URL=http://127.0.0.1:8001/api/llm

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Code sandbox
SANDBOX_URL=http://127.0.0.1:8002/execute

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SSL / TLS (production only — leave empty for local development)
# Granian natively handles TLS via rustls when both paths are set.
SSL_CERT_PATH=
SSL_KEY_PATH=

# =============================================================================
# Air-gapped / Artifactory Environment Overrides
# =============================================================================
# If you use Artifactory or another internal mirror, set these values.
# Leave empty to use default public internet sources.

# Docker Images
DOCKER_REDIS_IMAGE=redis:alpine
DOCKER_POSTGRES_IMAGE=pgvector/pgvector:pg16
DOCKER_GROBID_IMAGE=lfoppiano/grobid:0.8.0
DOCKER_OLLAMA_IMAGE=ollama/ollama
DOCKER_VLLM_IMAGE=vllm/vllm-openai:latest

# Python Package Index (e.g., "https://my-artifactory.local/api/pypi/pypi/simple")
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# HuggingFace Hub Mirror (e.g., "https://my-artifactory.local/api/huggingface")
HF_ENDPOINT=

# ML Models
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Python Indices
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# Vendored Resources
SPACY_WHEEL_URL=https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
SPACY_WHEEL_HASH=1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85
EDITDISTANCE_GIT_URL=git+https://github.com/roy-ht/editdistance.git@3f5a5b0299f36662349df0917352a42c620e3dd4
