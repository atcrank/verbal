# =============================================================================
# Verbal Project — Environment Configuration
# =============================================================================
# Copy this file to .env and edit values for your deployment.
# .env is already in .gitignore and will NOT be committed.
#
# Master environment switch: "dev" or "prod"
VERBAL_ENV=dev
PYENV_ACTIVATE="../../py313/bin/activate"

# Django core
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=verbal_db
DB_USER=verbal_user
DB_PASSWORD=verbal_password
DB_HOST=localhost
DB_PORT=5433

# Microservice role: standalone | inference | web | worker
VERBAL_ROLE=standalone

# Inference server URL (used when VERBAL_ROLE=web or worker)
INFERENCE_URL=http://127.0.0.1:8001/api/llm

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Code sandbox
SANDBOX_URL=http://127.0.0.1:8002/execute

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
