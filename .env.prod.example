# =============================================================================
# Verbal / Reason — Production Deployment Configuration (.env.prod)
# =============================================================================
# Copy this file to .env.prod and customize for your target host.
# .env.prod is untracked (.gitignore) and will NOT be committed to git.
#
# Fabric deployment commands (`fab deploy`, `fab setup-nginx-and-ssl`, etc.)
# automatically discover and load .env.prod prior to executing remote tasks.

# -----------------------------------------------------------------------------
# 1. Target Host & Remote Fabric Connection
# -----------------------------------------------------------------------------
REASON_HOST=localhost
REASON_DEPLOY_USER=verbal_deploy       # Deployment operator (SSH user with sudo access)
# SUDO_PASSWORD=                      # Optional: sudo password for non-interactive runs

# -----------------------------------------------------------------------------
# 2. Server Paths & Application Topology
# -----------------------------------------------------------------------------
REASON_APP_NAME=reason
REASON_BASE_DIR=/srv/reason
REASON_APP_USER=verbal_run            # Unprivileged service account for systemd (nologin)
REASON_WEB_GROUP=www-data             # Shared group for Nginx and socket access
REASON_VENV=/srv/reason/venv
REASON_HF_CACHE=/var/lib/hf_home      # Shared persistent cache for HuggingFace models
WORKSPACES_DIR=/srv/reason/shared/workspaces

# -----------------------------------------------------------------------------
# 3. Domain, Web & SSL / TLS Configuration
# -----------------------------------------------------------------------------
REASON_DOMAIN=reason.andrew.com
REASON_GRANIAN_PORT=8008
REASON_INFERENCE_PORT=8001
REASON_REMOVE_DEFAULT_NGINX=false     # Set to true to unlink /etc/nginx/sites-enabled/default

# Optional explicit SSL certificate file paths (defaults to /srv/reason/ssl/${REASON_DOMAIN}.*)
# REASON_SSL_CERT_PATH=/srv/reason/ssl/reason.andrew.com.crt
# REASON_SSL_KEY_PATH=/srv/reason/ssl/reason.andrew.com.key

# -----------------------------------------------------------------------------
# 4. Git Synchronization
# -----------------------------------------------------------------------------
REASON_GIT_URL=
REASON_GIT_BRANCH=main

# -----------------------------------------------------------------------------
# 5. Database (PostgreSQL) Configuration
# -----------------------------------------------------------------------------
REASON_DB_CONTAINER=verbal_db
DB_NAME=verbal_db
DB_USER=verbal_user
DB_PASSWORD=verbal_password
DB_PORT=5433
DB_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# 6. Django Production Settings
# -----------------------------------------------------------------------------
VERBAL_ENV=prod
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION-TO-SECURE-KEY
DJANGO_ALLOWED_HOSTS=reason.andrew.com,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# 7. Enterprise Pip / Artifactory / Mirror Overrides
# -----------------------------------------------------------------------------
# HTML link page (e.g. Artifactory wheel folder or PyTorch wheels)
PIP_FIND_LINKS=
# Custom PyPI / Artifactory simple index URL
PIP_INDEX_URL=
# Trusted host for HTTP mirrors or private enterprise certs
PIP_TRUSTED_HOST=
