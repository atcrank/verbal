# =============================================================================
# Verbal / Reason — Deployment Orchestration Configuration (.env.deploy)
# =============================================================================
# Copy this file to .env.deploy and customize for your target host.
# .env.deploy is untracked (.gitignore) and will NOT be committed to git.
#
# Fabric deployment commands (`fab deploy`, `fab setup-nginx-and-ssl`, etc.)
# automatically import your application settings from .env (such as DB credentials,
# Django secrets, and Artifactory/pip mirrors) and apply these deployment-specific
# settings on top.

# -----------------------------------------------------------------------------
# 1. Target Host & Remote SSH Connection (Human Operator / Administrator)
# -----------------------------------------------------------------------------
# Remote server to connect to (can also be user@hostname or IP)
REASON_HOST=localhost

# Optional: SSH username used by Fabric to connect to the server (your personal/admin account).
# If omitted, Fabric defaults to your current local username or ~/.ssh/config.
# This account must have sudo privileges to perform root-level operations.
# REASON_SSH_USER=

# Optional: sudo password for non-interactive runs
# SUDO_PASSWORD=

# -----------------------------------------------------------------------------
# 2. Local Accounts & Directory Hierarchy on Target Server (3-Tier Model)
# -----------------------------------------------------------------------------
REASON_APP_NAME=reason
REASON_BASE_DIR=/srv/reason

# Tier 2: Code Owner & Maintenance User
# A dedicated local unprivileged account on the server with a home directory.
# Owns /srv/reason/repo, /srv/reason/app, and /srv/reason/venv.
# Holds SSH deploy keys in /home/verbal_deploy/.ssh/ to pull from private git repo.
REASON_DEPLOY_USER=verbal_deploy

# Tier 3: Application Runtime Daemon User
# A locked-down system service account with /usr/sbin/nologin (no shell, no password).
# Systemd runs the background services (reason-web, worker, scheduler, inference) as this user.
REASON_APP_USER=verbal_run

# Shared group for socket and web asset read access (e.g. www-data)
REASON_WEB_GROUP=www-data

REASON_VENV=/srv/reason/venv
REASON_HF_CACHE=/var/lib/hf_home      # Shared persistent cache for HuggingFace models

# -----------------------------------------------------------------------------
# 3. Domain, Web & SSL / TLS Configuration
# -----------------------------------------------------------------------------
REASON_DOMAIN=reason.andrew.com
REASON_GRANIAN_PORT=8008
REASON_INFERENCE_PORT=8001
REASON_REMOVE_DEFAULT_NGINX=true      # Set to false to preserve /etc/nginx/sites-enabled/default

# Optional explicit SSL certificate file paths (defaults to /srv/reason/ssl/${REASON_DOMAIN}.*)
# REASON_SSL_CERT_PATH=/srv/reason/ssl/reason.andrew.com.crt
# REASON_SSL_KEY_PATH=/srv/reason/ssl/reason.andrew.com.key

# -----------------------------------------------------------------------------
# 4. Git Synchronization
# -----------------------------------------------------------------------------
REASON_GIT_URL=
REASON_GIT_BRANCH=main

# -----------------------------------------------------------------------------
# 5. Database Container (Only needed if PostgreSQL runs in Docker container)
# -----------------------------------------------------------------------------
REASON_DB_CONTAINER=verbal_db

# -----------------------------------------------------------------------------
# 6. Vendored & Internal Model Mirrors (spaCy en_core_web_sm)
# -----------------------------------------------------------------------------
# If the target host cannot access GitHub or the wheel is not in git,
# configure your internal Artifactory wheel URL or mirror here:
# SPACY_WHEEL_URL=https://artifactory.local/artifactory/wheels/en_core_web_sm-3.8.0-py3-none-any.whl
